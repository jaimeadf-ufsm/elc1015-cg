				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="../__bin/Release/canvas2d" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../" />
				<Option object_output="../__obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O3 -Wall" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
			<Add option="-std=c++11" />
			<Add directory="../include" />
		</Compiler>
		<Linker>
			<Add library="../lib/libfreeglut32.a" />
