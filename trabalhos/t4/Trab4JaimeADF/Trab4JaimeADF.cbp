	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Canvas 2D" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="../__bin/Debug/canvas2d" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../" />
				<Option object_output="../__obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
